+        // a fence the backend can complete without touching any guest page.
+        rasterizer->Query(ReservedScratchAddress(), VideoCommon::QueryType::Payload,
+                          one_word ? VideoCommon::QueryPropertiesFlags::IsAFence
+                                   : VideoCommon::QueryPropertiesFlags::HasTimeout,
+                          payload, 0);
         return;
     }
