 // SET_REPORT_SEMAPHORE_A-D (0x6c0-0x6c3): address high/low, payload, then operation in bits 1:0
 // (release / acquire / report only / trap), reduction enable bit 3 with the op in bits 11:9, and
 // a one-word (no timestamp) structure in bit 28. NVN2 releases queue syncs from compute this way.
+// A release whose SET_REPORT_SEMAPHORE_A was never written reads GPU VA 0: the payload goes to
+// the void and its waiter hangs forever on memory nothing ever wrote. On the host that memory
+// reads as zeros, so a lost release looks harmless; on the PS5 it reads the unbacked pattern
+// 0xafafafaf, the game replays those dwords as register methods and dies in the write replay
+// (the 0x1314f070ac GPUBack crash, the boot loop's unmapped Prepare Thread jump, the GL/Vulkan
+// memory_manager.cpp:277 asserts). Say so loudly, and run the release to the class's reserved
+// scratch VA instead of dropping it: the queue keeps moving while the real bug shows in the log.
 void KeplerCompute::ProcessNativeReportSemaphore(u32 argument) {
     const GPUVAddr address = (GPUVAddr{native_registers[0x6c0] & 0x1ffffff} << 32) |
                              native_registers[0x6c1];
@@ -96,6 +103,22 @@
     }
     if (operation != 0 && operation != 2) {
         LOG_WARNING(HW_GPU, "Native compute report semaphore operation {} not supported", operation);
+        return;
+    }
+    if ((native_registers[0x6c0] & 0x1ffffff) == 0) {
+        static u32 guarded{};
+        if (guarded++ < 32) {
+            LOG_WARNING(HW_GPU,
+                        "Native compute report semaphore address is null (SET_REPORT_SEMAPHORE_A "
+                        "never written): parking the release at the reserved scratch VA instead "
+                        "of dropping it to VA 0");
+        }
