--- a/src/core/file_sys/vfs/vfs_real.cpp
+++ b/src/core/file_sys/vfs/vfs_real.cpp
@@ -18,6 +18,7 @@
 
 // For FileTimeStampRaw
 #include <sys/stat.h>
+#include <sys/resource.h>
 
 #ifdef _WIN32
 #include <cstdio> // _getmaxstdio
@@ -40,12 +41,21 @@
 // Files the cache keeps open. On Windows it has to stay below the C runtime's open-file limit with
 // room to spare: at the limit every other open fails (saves, shader caches, and the cache's own
 // next file, which it only evicts for once it reaches its cap).
+// On Unix the cap follows the process's own file-descriptor limit (raised by the frontend, as
+// upstream's Qt frontend does), minus room for those other users: Mario Kart World opens its
+// RomFS tables while well over two thousand files are still open, and a hard 8192 with a lower
+// kernel limit meant every open past that failed with "Too many open files" (the game's
+// Prepare Thread then jumped through a null RSDB table pointer).
 size_t MaxOpenFiles() {
 #ifdef _WIN32
     static const size_t limit = static_cast<size_t>((std::max)(_getmaxstdio() - 512, 64));
     return (std::min)(size_t{8192}, limit);
 #else
-    return 8192;
+    struct ::rlimit rl;
+    static const size_t limit = ::getrlimit(RLIMIT_NOFILE, &rl) == 0
+                                    ? static_cast<size_t>(rl.rlim_cur > 512 ? rl.rlim_cur - 512 : rl.rlim_cur)
+                                    : size_t{1024};
+    return (std::min)(size_t{8192}, (std::max)(limit, size_t{64}));
 #endif
 }
 
